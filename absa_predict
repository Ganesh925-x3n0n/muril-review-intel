"""
absa_predict.py — Run inference with the trained MuRIL ABSA model

What this file does:
  - Loads the trained ABSA model from muril_absa_model/
  - For each review, predicts which aspects are present
  - For each detected aspect, predicts its sentiment
  - Combines with rule-based fallback if ML confidence is low

This is separate from predict.py — it only handles ABSA inference.
server.py imports both predict.py and this file.

Usage (single text):
  python absa_predict.py --text "Delivery was fast but quality is poor"

Usage (batch CSV):
  python absa_predict.py --csv reviews.csv --output absa_results.csv

Requirements:
  pip install transformers torch pandas
  (run absa_train.py first to generate muril_absa_model/)
"""

import argparse
import json
import os
import sys

import torch
import torch.nn as nn
import torch.nn.functional as F
from transformers import AutoTokenizer, AutoModel
import pandas as pd


# ── Reproduce model architecture from absa_train.py ───────────────────────────
class MuRILABSAModel(nn.Module):
    def __init__(self, model_name, num_aspects, num_classes_per_aspect, dropout=0.3):
        super().__init__()
        self.encoder     = AutoModel.from_pretrained(model_name)
        hidden           = self.encoder.config.hidden_size
        self.dropout     = nn.Dropout(dropout)
        self.num_aspects = num_aspects
        self.aspect_heads = nn.ModuleList([
            nn.Linear(hidden, num_classes_per_aspect)
            for _ in range(num_aspects)
        ])

    def forward(self, input_ids, attention_mask):
        out    = self.encoder(input_ids=input_ids, attention_mask=attention_mask)
        pooled = self.dropout(out.last_hidden_state[:, 0, :])
        return [head(pooled) for head in self.aspect_heads]


# ── Rule-based fallback (used when ABSA model is unavailable) ─────────────────
ASPECT_LEXICON = {
